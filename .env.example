# ===================== 飞书自建应用 =====================
# 飞书开放平台 → 创建企业自建应用 → 凭证与基础信息
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===================== 大模型（OpenAI 兼容接口）=====================
# 默认 DeepSeek；换成任何 OpenAI 兼容服务只要改这三行
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===================== WHOOP 开发者应用 =====================
# WHOOP Developer Dashboard → 你的 App → Client ID / Client Secret
WHOOP_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
WHOOP_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===================== 运行参数（一般不用改）=====================
# 容器内路径，对应 compose 里 ./app/data 的挂载点
FITNESS_DB_PATH=/app/data/fitness.db
FITNESS_PROFILE_PATH=/app/data/profile.json
WHOOP_TOKEN_PATH=/app/data/whoop_token.json
