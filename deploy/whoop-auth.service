[Unit]
Description=WHOOP OAuth2 Authorization Helper
After=network.target

[Service]
Type=simple
# 改成你的实际部署路径
WorkingDirectory=/opt/whoop-fitness-agent/app
Environment=WHOOP_DATA_DIR=/opt/whoop-fitness-agent/app/data
ExecStart=/usr/bin/python3 /opt/whoop-fitness-agent/app/whoop_auth.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# 最小权限
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/whoop-fitness-agent/app/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
